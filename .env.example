# Google Gemini API Key (Required for cloud inference)
# Obtain your key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_API_KEY=your_google_api_key_here

# Optional: Local Ollama fallback endpoint (defaults to http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Locally Hosted Decision Model & Browser Agent (jev-ultrafast)
USE_LOCAL_DECISION_MODEL=true
USE_LOCAL_TEXT_MODEL=true
LOCAL_MODEL_BASE_URL=http://localhost:11434/v1
LOCAL_MODEL_NAME=llama3.2:latest
LOCAL_MODEL_API_KEY=ollama
